# --- Wiki.js upstream credentials ---
# Base URL of your Wiki.js instance (no trailing slash).
WIKIJS_URL=https://wiki.example.com

# An API key issued in Wiki.js: Administration -> API Access -> New API Key.
# This is a single JWT-format token. Grant only the permissions you want Claude
# to have (read+write on Pages is a sane starting point — avoid "Full Access").
WIKIJS_API_KEY=

# --- MCP server OAuth ---
# Secret used to sign the JWT access/refresh tokens this server issues to AI clients.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Master password the user types on the consent screen when a new AI client
# (Claude Code, Claude Desktop, ChatGPT, etc.) requests authorization. Single-user mode.
OAUTH_PW=

# --- Local bind address (reverse proxy terminates TLS) ---
LOCAL_SERVER_HOSTNAME=127.0.0.1
LOCAL_SERVER_PORT=3000

# Public HTTPS URL the reverse proxy exposes, used as the OAuth issuer
# and JWT audience. Must match exactly what you tell Claude.
PUBLIC_URL=https://wikijs-mcp.example.com
